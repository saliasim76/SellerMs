# Copy this file to .env and fill in real values for your environment.
# .env is gitignored and never committed.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=sellerms
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Overrides all DB_* above at once if set (e.g. a full managed-DB connection string).
# DATABASE_URL=mysql+pymysql://user:password@host:3306/sellerms?charset=utf8mb4

# cPanel-style shared hosting auto-prefixes every MySQL database (and DB
# user) with your cPanel account name -- e.g. a SaaS tenant meant to be
# named "Noman" really gets created as "proledg_Noman", and DB_USER above
# is itself only ever granted access to databases matching that same
# prefix. Set this to your cPanel account name (with the trailing
# underscore, e.g. "proledg_") so every new tenant database
# database/tenant_provisioning.py creates is automatically named within
# what the host actually allows. Leave blank for local dev or any host
# with no such restriction.
# TENANT_DB_PREFIX=proledg_

# Random secret used to sign sessions/cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Password for the auto-seeded SuperAdmin account (database/routes/rbac.py).
# Only used the ONE time that account is first created on a brand-new
# database -- has no effect afterward. Set this before that first boot in
# production; never reuse your DB_PASSWORD here.
SUPER_ADMIN_PASSWORD=change-me-too

# Passwords for the two other auto-seeded default accounts (Admin / User),
# same one-time-only-at-creation rule as SUPER_ADMIN_PASSWORD above.
DEFAULT_ADMIN_PASSWORD=change-me-too
DEFAULT_USER_PASSWORD=change-me-too
