# Secrets / environment
.env
*.env
!.env.example

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
venv/

# Logs
*.log

# Legacy/local database artifacts (this app is MySQL-only, see config.py)
database/*.db
*.sqlite3

# User-uploaded content -- real business data, not source code.
# Persist this on the host directly (upload once, back it up separately);
# never deploy or overwrite it via git.
uploads/*
!uploads/.gitkeep
static/uploads/*
!static/uploads/.gitkeep

# Created on the host by cPanel's Setup Python App (public/) and by
# .cpanel.yml's restart.txt touch (tmp/) -- never source, and untracked files
# there would make the checkout look "dirty" and block cPanel's deploy button.
public/
tmp/

# Editor/OS cruft
.vscode/
.idea/
.DS_Store
Thumbs.db

# Claude Code tooling config -- local machine paths/permissions, not app source
.claude/
